# ──────────────────────────────────────────────
# MediCloud Backend Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# Do NOT commit the real .env file to Git.

# ── Server ──
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://medicloud-sv.vercel.app/
FRONTEND_ORIGIN=http://localhost:5173

# ── Logging ──
# Options: error | warn | info | debug | verbose
LOG_LEVEL=info

# ── Feature Provider Flags ──
# "mock" = use local in-memory adapter (no AWS needed)
# "aws"  = use real AWS service (requires valid AWS credentials + config)
DB_PROVIDER=mock
AUTH_PROVIDER=mock
STORAGE_PROVIDER=mock
EMAIL_PROVIDER=mock

# ── AWS ──
AWS_REGION=ap-south-1

# ── Amazon DynamoDB ──
DYNAMODB_TABLE_NAME=medicloud-local

# ── Amazon Cognito ──
# Leave empty in development to use mock auth adapter.
# In production, set these to your Cognito User Pool values.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Keep the real value only in the ignored backend/.env file. Never expose it to the frontend.
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# ── Amazon S3 ──
S3_BUCKET_NAME=medicloud-medical-files-0234

# ── Brevo Email ──
# Leave API key empty in development to use mock email adapter.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@medicloud.local
BREVO_SENDER_NAME=MediCloud Notifications
