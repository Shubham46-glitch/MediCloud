# ──────────────────────────────────────────────────────────────────
# MediCloud Frontend Configuration
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env.local and adjust values as needed.
# Do NOT commit the real .env file to Git.
#
# Vite only exposes variables prefixed with VITE_ to the browser.
# Never put secret keys, API keys, or credentials here —
# anything in a Vite .env file is visible to every browser visitor.

# ── Backend API ──
# URL of the MediCloud Express backend.
# Local development backend. In Vercel, set VITE_API_URL to the deployed API URL.
VITE_API_URL=http://localhost:5000

# ── Amazon Cognito (public identifiers — safe to expose) ──
# Required only when AUTH_PROVIDER=cognito is enabled on the backend.
# Leave empty during local development with mock auth.

# ── App Meta ──
# Optional: shown in page titles, error pages, etc.
VITE_APP_NAME=MediCloud
VITE_APP_ENV=development
